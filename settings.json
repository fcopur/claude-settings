{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "theme": "dark-daltonized",
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/statusline.py",
    "padding": 0
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/writing-check.py",
            "statusMessage": "Checking writing..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/bash-guard.py",
            "statusMessage": "Checking command safety..."
          }
        ]
      }
    ]
  }
}
